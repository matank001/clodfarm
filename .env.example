# Optional. Copy to .env to change settings; every one has a default and claude-farm runs without this file.

# --- Login (pick one, see docs/auth.md) -------------------------------------
# A) leave empty and run `docker exec -it claude-farm claude-farm login`
# B) a long-lived token from `claude setup-token` on your own computer:
# CLAUDE_CODE_OAUTH_TOKEN=
# D) an API key (pay per token). Set a daily cap too:
# ANTHROPIC_API_KEY=
# FARM_DAILY_BUDGET_USD=20
# FARM_TASK_BUDGET_USD=5

# --- What the agents work on -------------------------------------------------
# The mission the planner keeps the agents busy with (or: claude-farm mission "..." after start).
# FARM_MISSION=Build a small, well-tested CLI that converts CSV to Markdown tables.
# A git URL to clone into /workspace/repo on first start (empty: a fresh local repo).
# Put a MISSION.md at the repo root: the planner keeps the agents busy with it.
FARM_REPO_URL=
# Push main to origin after each merged task (needs push access, e.g. a deploy key).
FARM_PUSH=1

# --- Agents ------------------------------------------------------------------
# shown in the Claude app (Remote Control) and logs
FARM_NAME=claude-farm
FARM_MODEL=opus
# upper bound; the governor decides how many run
FARM_MAX_WORKERS=3
# the container is the sandbox; see docs/security.md
FARM_PERMISSION_MODE=bypassPermissions
# keep `claude remote-control` up so you can drive it from your phone
FARM_REMOTE_CONTROL=1
FARM_RC_CAPACITY=4
# when the queue is empty, plan the next tasks from MISSION.md
FARM_PLANNER=1
# seconds per agent run (a timed-out run is resumed in its own session up to FARM_TIMEOUT_RESUMES times)
FARM_TASK_TIMEOUT=5400
# effort for every agent: low | medium | high | xhigh | max (empty = Claude Code's default)
# FARM_EFFORT=

# --- Quality gate and safety -------------------------------------------------
# A check that must pass before a finished task lands on main (it runs in the task's worktree, rebased onto main).
# On failure the agent is resumed with the output, up to FARM_VERIFY_FIXES times.
# FARM_VERIFY_CMD=python3 -m pytest -q
# FARM_VERIFY_FIXES=2
# This many failed runs in a row pause every box (resume with `claude-farm resume`). 0 = never.
FARM_STALL_THRESHOLD=5
# Where to tell you about failures, pauses, usage limits and "nothing left to do":
# an ntfy topic (https://ntfy.sh/<secret-topic>), a Slack incoming webhook, or a Discord webhook.
# FARM_NOTIFY_URL=

# --- Budget governor (fractions of your subscription's limits) --------------
# agents stop at 80% of the 7-day window: 20% stays yours
FARM_WEEKLY_TARGET=0.80
# never push a 5-hour window past this
FARM_FIVE_HOUR_CEILING=0.85
# optional: this many hours before the weekly reset, skip weekly pacing (up to the target). 0 = off
FARM_BURST_HOURS=0
# never draw on paid extra usage
FARM_ALLOW_OVERAGE=0

# --- Several boxes / several Claude accounts in one farm (docs/multi-seat.md) ---
# Every box uses the same FARM_TABLE and FARM_REPO_URL. The seat (account) is derived from the login.
# FARM_SEAT=
# FARM_RESUME_AFFINITY=600

# --- Storage -----------------------------------------------------------------
# sqlite (default): one box, the farm lives in /workspace/.farm/farm.db. Nothing to set up.
# dynamodb: several boxes and/or several Claude accounts share one farm (docs/multi-seat.md).
# FARM_STORE=dynamodb
# FARM_TABLE=claude-farm
# AWS_REGION=us-east-1
# For DynamoDB Local during development: FARM_DYNAMODB_ENDPOINT=http://localhost:8000
